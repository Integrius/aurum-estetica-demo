# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by Prisma (schema.prisma + migrations + seed).
# Any Postgres works; this project was developed against Neon, whose URLs need
# ?sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/aurum?sslmode=require"

# Secret NextAuth uses to sign and encrypt the session JWT. Required — without
# it the admin panel silently fails to keep you logged in.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Only needed when deploying. Locally NextAuth defaults to http://localhost:3000.
# NEXTAUTH_URL="https://your-domain.example"

# Segredo do endpoint de limpeza do demo (POST /api/demo/reset).
# Gere com: openssl rand -hex 32
DEMO_RESET_SECRET=

# Admin user created by `npx prisma db seed` (the password is never stored in the code).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=
